# Dependencies
node_modules/

# Build artifacts — publish to GitHub Releases, not the tree
*.vsix
*.stackdump

# OS
.DS_Store
Thumbs.db

# Secrets — no runtime, but defense-in-depth so one is never committed
.env
.env.*

# Python bytecode (from test-fixtures)
__pycache__/
*.pyc

# Local-only large media (demo lives on Marketplace / Release assets)
video/

# Repo-local docs (PUBLISHING, proposals, etc.) — canon files are tracked
docs/*
!docs/DESIGN_STANDARDS.md
!docs/PALETTE_INDEX.md
CLAUDE.md
scripts/

# Local tooling & generated artifacts (not committed)
.playwright-mcp/

# Local scratch dirs
.cursor/
test-fixtures/versions/**/*