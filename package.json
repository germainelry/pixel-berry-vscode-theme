{
  "name": "pixel-berry",
  "displayName": "Pixel Berry",
  "description": "A cozy dark theme with warm berry tones — wine backgrounds, raspberry accents, and rose-pink syntax. Designed for long coding sessions.",
  "version": "0.1.2",
  "publisher": "germainelry",
  "license": "MIT",
  "icon": "images/pixel-berry-logo.png",
  "galleryBanner": {
    "color": "#2a2230",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.72.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color-theme",
    "dark-theme",
    "dark",
    "cozy",
    "pink",
    "purple",
    "warm",
    "berry",
    "burgundy",
    "wine",
    "raspberry",
    "rose",
    "lavender",
    "plum",
    "magenta",
    "soft",
    "aesthetic",
    "low-contrast",
    "eye-friendly",
    "readable",
    "night-coding",
    "long-coding",
    "syntax-highlighting",
    "editor-theme",
    "developer-theme",
    "code-theme",
    "vscode-theme",
    "vscodium",
    "open-vsx"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Pixel Berry",
        "uiTheme": "vs-dark",
        "path": "./themes/pixel-berry-color-theme.json"
      }
    ]
  },
  "scripts": {
    "package": "vsce package",
    "publish:vscode": "vsce publish",
    "publish:openvsx": "ovsx publish"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/germainelry/pixel-berry-vscode-theme.git"
  },
  "sponsor": {
    "url": "https://ko-fi.com/germainelry"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.15.0",
    "ovsx": "^0.10.0"
  }
}
